# ============================================================
#  عيادة الدكتورة أنس جوبي — متغيرات البيئة
#  انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع ملف .env إلى أي مكان عام.
# ============================================================

# ===== قاعدة البيانات =====
# في الإنتاج استخدم كلمة مرور قوية لمستخدم قاعدة البيانات
DATABASE_URL="postgresql://dental:CHANGE_DB_PASSWORD@localhost:5432/anas_dental?schema=public"
POSTGRES_PASSWORD="CHANGE_DB_PASSWORD"

# ===== المصادقة =====
# مطلوب: 32 حرفاً على الأقل. ولّده عبر:  openssl rand -base64 48
AUTH_SECRET=""
AUTH_COOKIE_NAME="anas_dental_session"
# مدة الجلسة بالثواني (12 ساعة)
SESSION_MAX_AGE_SECONDS="43200"

# ===== التطبيق =====
# الرابط النهائي للموقع (مع https)
NEXT_PUBLIC_APP_URL="https://example.com"
NEXT_PUBLIC_APP_NAME="عيادة الدكتورة أنس جوبي لطب الأسنان"
# المنطقة الزمنية للعيادة — مهمة لحساب أوقات المواعيد
TZ="Asia/Damascus"

# ===== واتساب =====
NEXT_PUBLIC_WHATSAPP_NUMBER="963944655028"

# ===== التخزين (ملفات المرضى والأشعة) =====
# local = على قرص الخادم (Docker/VPS) — s3 = تخزين سحابي خاص (Supabase Storage) للاستضافة المجانية
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# على Netlify ضعها 5 (حد حجم الطلب هناك 6 ميغابايت)
MAX_UPLOAD_MB="10"

# ===== الإشعارات =====
NOTIFICATIONS_DRIVER="database"

# ===== حساب الدكتورة أنس (الحساب الإداري الوحيد — يُنشأ مرة واحدة عند npm run setup) =====
# الدخول برقم الموبايل. إن تُركت كلمة المرور فارغة تُولَّد كلمة قوية وتُطبع مرة واحدة.
SEED_ADMIN_PHONE="0944655028"
SEED_ADMIN_PASSWORD=""
