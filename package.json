{
  "name": "anas-jouby-dental-clinic",
  "version": "1.0.0",
  "private": true,
  "description": "Dr. Anas Jouby dental clinic website and management platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/copy-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "cloud-build": "node node_modules/@prisma/engines/scripts/postinstall.js && prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts && next build",
    "vercel-build": "npm run cloud-build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.454.0",
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.26",
    "postcss": "^8.5.28",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
